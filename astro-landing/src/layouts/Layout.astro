---
import '../styles/global.css';

interface Props {
  /** This route renders its own declarative product footer. */
  hasProductFooter?: boolean;
  title: string;
}

const { title } = Astro.props;
const hasProductFooter = Astro.props.hasProductFooter === true;
---

<!doctype html>
<html lang="en" class="bg-black">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700;800;900&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Montserrat:wght@200;300;400&display=swap" rel="stylesheet">
	</head>
	<body class="text-[#dcdde1] antialiased selection:bg-[#c2a36b]/30 selection:text-white">
		
		<slot />
    {!hasProductFooter && <fleet-footer-extension product-name="AliveVille" art-src="/footer-art/ai-game.webp" surface="app" art-alt="AliveVille: An original inhabited village centers a noticeboard and a contested crossing. Distinct invented characters meet and take separate paths; modest dwellings and memory tokens suggest persistence, relationships and friction." art-width="2168" art-height="725" art-position="50% 50%" art-credit="Original illustration for AliveVille"></fleet-footer-extension>}
		<script is:inline>
			(function(c,l,a,r,i,t,y){
				c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
				t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
				y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
			})(window,document,"clarity","script","y6bv5ous5y");
			window.clarity("set","project_id","ai-game");
		</script>
		<script
			is:inline
			src="https://sassmaker.com/project-strip.js"
			data-project="ai-game"
			defer
		></script>
		<script
			is:inline
			src="https://sassmaker.com/ai-chat-footer.js"
			data-name="AliveVille"
			defer
		></script>
		<script
			is:inline
			src="https://health.sassmaker.com/tracker.js"
			data-key="ahk_pub_2f74e5ff486ddc1ba23438681941af223efa6869133e5a37ae12ca7135815b0f"
			data-project="app-import-f8ca05726a079123c25fd18a2e7c296ecf1711819ca66e269d0ca7c9131deb8c"
			data-identity="session"
			defer
		></script>
		<script is:inline>
			document.addEventListener('click', (event) => {
				if (event.target instanceof Element && event.target.closest('a[href="/game/"]')) {
					window.appHealth?.track('play_now_clicked');
				}
			});
		</script>

	</body>
</html>

<style is:global>
	body {
		font-family: 'Montserrat', sans-serif;
		background-color: #000;
	}
	
	h1, h2, h3, h4, h5, h6 {
		font-family: 'Cinzel', serif;
	}

	.font-serif-italic {
		font-family: 'Cormorant Garamond', serif;
	}

	/* Hidden scrollbar for pure immersion */
	::-webkit-scrollbar {
		width: 0px;
		background: transparent;
	}

	.thorgal-title {
		text-shadow: 0 4px 20px rgba(0,0,0,0.9), 0 0 40px rgba(0,0,0,0.5);
	}
</style>
