---
import copy from '../content/readable/privacy.json';
import LegalLayout from '../layouts/LegalLayout.astro';
---
<LegalLayout title={copy.title} description={copy.description} path="/privacy">
  <main style="max-width:42rem;margin:0 auto;padding:4rem 1.5rem;line-height:1.7;color:#d1d1d6;">
    <a href={copy.links.link_1} style="font-size:0.75rem;color:#888;">{copy.text.aliveville}</a>
    <h1 style="margin-top:1rem;font-size:2rem;">{copy.text.privacy_policy}</h1>
    <p style="font-size:0.75rem;color:#888;">{copy.text.last_updated_june_10_2026}</p>
    <p style="margin-top:1rem;">
      {copy.text.aliveville_com_is_a_static_marketing}
    </p>
    <p style="margin-top:1rem;">
      {copy.text.contact} <a href={copy.links.link_2} style="color:#f8d44e;">{copy.text.sarthakagrawal927_gmail_com}</a>
    </p>
  </main>
</LegalLayout>
