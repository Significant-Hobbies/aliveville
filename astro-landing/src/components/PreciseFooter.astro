---
// Framework-free StudioFooter (SaaS Maker UI v0.1.15). Files in public/ui/ are the
// committed footer.css / footer.js from that tag; replace them together on upgrade.
const config = {
  summary:
    'A paused AI world-simulator experiment. The hosted game is offline; the source is public. Built by Sarthak Agrawal.',
  legal: `© ${new Date().getFullYear()} AliveVille · Open-source experiment`,
  privacyUrl: '/privacy',
  art: {
    src: '/footer-art/aliveville-town-world-v1.webp',
    alt: 'An invented village at dusk, with residents meeting along garden paths between warmly lit homes.',
    position: '50% 58%',
  },
  groups: [
    {
      title: 'Project',
      links: [
        { label: 'AI world simulator', href: '/ai-world-simulator' },
        { label: 'Privacy', href: '/privacy' },
        { label: 'Terms', href: '/terms' },
      ],
    },
    {
      title: 'Resources',
      links: [
        { label: 'Source on GitHub', href: 'https://github.com/sarthakagrawal927/aliveville' },
        { label: 'Sarthak', href: 'https://sarthakagrawal.dev' },
        { label: 'Foundry', href: 'https://sassmaker.com' },
      ],
    },
  ],
};
---
<link rel="stylesheet" href="/ui/footer.css" />
<script type="module" src="/ui/footer.js"></script>
<studio-footer
  product="AliveVille"
  url="https://aliveville.com"
  catalog-id="ai-game"
  capture="newsletter"
  variant="studio"
  art-mode="scene"
  wordmark="poster"
  data-theme="dark"
  data-mode="dark"
>
  <script type="application/json" set:html={JSON.stringify(config)} />
</studio-footer>

<style is:global>
  /* Library gap (v0.1.15): in the stacked mobile layout the email input's flex-1 collapses its height. */
  studio-footer form[data-subscribe] input[type='email'] {
    flex: none;
    min-height: 3rem;
  }
  @media (min-width: 640px) {
    studio-footer form[data-subscribe] input[type='email'] {
      flex: 1 1 0%;
    }
  }
</style>
